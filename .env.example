# Copie para .env e ajuste conforme necessário.
# Usado tanto pelo docker-compose.yml quanto pelos binários Go
# (rhaxis-api, rhaxis-load, rhaxis-link), que leem estas env vars
# como default dos respectivos flags de CLI.

# --- Neo4j ---
# Credenciais do container neo4j (docker-compose) — formato usuario/senha.
NEO4J_AUTH=neo4j/rhaxis-dev

# URI/credenciais que os binários usam para conectar.
# Rodando via docker-compose, o host é o nome do serviço ("neo4j");
# rodando os binários direto na máquina (fora de container), use "localhost".
NEO4J_URI=neo4j://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASS=rhaxis-dev
NEO4J_DB=

# --- rhaxis-api ---
API_ADDR=:8080
